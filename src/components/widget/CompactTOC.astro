---
import type { MarkdownHeading } from 'astro'
import { siteConfig } from '../../config'

interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props
const minDepth = Math.min(...headings.map(heading => heading.depth))
const entries = headings.filter(heading => heading.depth < minDepth + siteConfig.toc.depth)
---
{entries.length > 0 && <details class="card-base rounded-[var(--radius-large)] px-6 py-4 mb-4 2xl:hidden">
  <summary class="font-bold cursor-pointer py-2 text-90">文章目录</summary>
  <nav aria-label="文章目录" class="mt-2">
    <ul class="flex flex-col gap-1">
      {entries.map(heading => <li class:list={{ 'ml-4': heading.depth === minDepth + 1, 'ml-8': heading.depth >= minDepth + 2 }}>
        <a href={`#${heading.slug}`} class="block rounded-lg py-2 px-2 text-75 hover:text-[var(--primary)]">{heading.text}</a>
      </li>)}
    </ul>
  </nav>
</details>}
