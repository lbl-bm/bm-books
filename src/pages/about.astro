---
import MainGridLayout from '../layouts/MainGridLayout.astro'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import { profileConfig } from '../config'
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div class="prose dark:prose-invert max-w-none mt-2">
                <h1>关于这个博客</h1>
                <p>这里是 {profileConfig.name} 的个人博客，目前处于内容整理阶段。</p>
                <p>“示例”分类中的文章来自 Fuwari 模板，用于演示 Markdown 排版和博客功能，不代表个人原创文章。</p>
                <p><a href="https://github.com/lbl-bm" target="_blank" rel="noopener noreferrer">GitHub 项目</a></p>
            </div>
        </div>
    </div>
</MainGridLayout>
